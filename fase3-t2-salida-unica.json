        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_cliente_id: $json.cliente_id, p_nombre: $json.nombre, p_telefono: $json.cliente_id }) }}",
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000006",
      "name": "Asegurar conversación",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        60,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "// Traduce el contrato interno al cuerpo que espera la Cloud API.\nconst p = $('Validar petición').first().json;\n\nconst cuerpo = {\n  messaging_product: 'whatsapp',\n  recipient_type: 'individual',\n  to: p.cliente_id,\n};\n\nif (p.accion === 'texto') {\n  cuerpo.type = 'text';\n  cuerpo.text = { preview_url: false, body: p.texto };\n} else {\n  cuerpo.type = p.accion === \"imagen\" ? \"image\" : p.accion;\n  const adj = { link: p.media_url };\n  // audio y video no admiten caption en la Cloud API; image y document sí.\n  if (p.texto && ['image','document'].includes(cuerpo.type)) adj.caption = p.texto;\n  cuerpo[cuerpo.type] = adj;\n}\n\n// Responder en hilo, si nos lo han pedido.\nif (p.responder_a) cuerpo.context = { message_id: p.responder_a };\n\nreturn [{ json: { cuerpo, peticion: p } }];"
      },
      "id": "c1000000-0000-4000-8000-000000000007",
      "name": "Construir mensaje Cloud API",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $env.WA_API_VERSION }}/{{ $env.WA_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WA_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.cuerpo) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "id": "c1000000-0000-4000-8000-000000000008",
      "name": "ENVIAR A WHATSAPP (único punto de salida)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "// Se registra SIEMPRE, salga bien o mal (regla 1).\nconst p = $('Validar petición').first().json;\nconst r = $json || {};\n\nconst codigo = r.statusCode || 0;\nconst cuerpo = r.body || r;\n// Doble negacion: sin ella, && devuelve el array messages en vez de true.\nconst ok = !!(codigo >= 200 && codigo < 300 && cuerpo && cuerpo.messages);\n\nconst wamid = ok ? (cuerpo.messages[0] || {}).id : null;\nconst error = ok ? null : ((cuerpo && cuerpo.error) || { message: r.error || 'sin respuesta de Meta' });\n\nconst TIPO = { texto: \"text\", imagen: \"image\", documento: \"document\", audio: \"audio\", video: \"video\" };\n\nreturn [{ json: {\n  ok,\n  wamid,\n  error,\n  fila: {\n    cliente_id:   p.cliente_id,\n    canal:        'whatsapp_cloud',\n    direccion:    'out',\n    autor:        p.autor,\n    tipo:         TIPO[p.accion] || 'text',\n    texto:        p.texto || null,\n    media_url:    p.media_url,\n    estado:       ok ? 'enviado' : 'fallido',\n    msg_id_canal: wamid,\n    payload:      ok ? null : { error, enviado: $(\"Construir mensaje Cloud API\").first().json.cuerpo },\n  },\n} }];"
      },
      "id": "c1000000-0000-4000-8000-000000000009",
      "name": "Preparar fila saliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
