{
  "name": "LumaBot — Salida WhatsApp (punto único)",
  "nodes": [
    {
      "parameters": {},
      "id": "c1000000-0000-4000-8000-000000000001",
      "name": "Cuando me llaman",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        -620,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Contrato de entrada. Todo lo que quiera hablar con WhatsApp pasa por aquí.\n//   accion      : texto | imagen | documento | audio | video | marcar_leido\n//   cliente_id  : wa_id del destinatario (regla 3: nunca el teléfono formateado)\n//   texto       : cuerpo, o pie de foto si es media\n//   media_url   : URL pública del adjunto\n//   autor       : bot | humano | sistema   (queda registrado en mensajes)\n//   responder_a : wamid al que se responde (opcional)\n//   wa_message_id : solo para marcar_leido\n\nconst e = $json || {};\nconst accion = String(e.accion || 'texto').toLowerCase();\nconst ACCIONES = ['texto','imagen','documento','audio','video','marcar_leido'];\n\nconst fallos = [];\nif (!ACCIONES.includes(accion)) fallos.push('accion no reconocida: ' + accion);\nif (accion === 'marcar_leido') {\n  if (!e.wa_message_id) fallos.push('marcar_leido necesita wa_message_id');\n} else {\n  if (!e.cliente_id) fallos.push('falta cliente_id');\n  if (accion === 'texto' && !e.texto) fallos.push('un texto vacío no se envía');\n  if (accion !== 'texto' && !e.media_url) fallos.push('falta media_url para ' + accion);\n}\nif (!$env.WA_TOKEN) fallos.push('falta WA_TOKEN en el entorno de n8n');\n\n// Fallamos aquí, antes de gastar una llamada a Meta y antes de escribir nada.\nif (fallos.length) {\n  throw new Error('Petición inválida — ' + fallos.join(' · '));\n}\n\nreturn [{ json: {\n  accion,\n  cliente_id:    String(e.cliente_id || ''),\n  texto:         e.texto || '',\n  media_url:     e.media_url || null,\n  autor:         ['bot','humano','sistema'].includes(e.autor) ? e.autor : 'bot',\n  responder_a:   e.responder_a || null,\n  wa_message_id: e.wa_message_id || null,\n  nombre:        e.nombre || null,\n} }];"
      },
      "id": "c1000000-0000-4000-8000-000000000002",
      "name": "Validar petición",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "a1",
              "leftValue": "={{ $json.accion }}",
              "rightValue": "marcar_leido",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000003",
      "name": "¿Solo marcar como leído?",
