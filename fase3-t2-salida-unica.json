        "jsCode": "// Lo que ve quien nos llamó.\nconst r = $('Preparar fila saliente').first().json;\nreturn [{ json: { ok: r.ok, wamid: r.wamid, error: r.error } }];"
      },
      "id": "c1000000-0000-4000-8000-000000000013",
      "name": "Devolver resultado",
      "type": "n8n-nodes-base.code",
